# Copiar a deploy/deploy.env (no se versiona) y completar.
DEPLOY_HOST="usuario@ip-del-servidor"
DEPLOY_PORT="65002"
DEPLOY_KEY="~/.ssh/clave_privada"
# Raíz de Laravel relativa al home del usuario SSH
DEPLOY_PATH="domains/tu-dominio/public_html"
# Endpoints a verificar después del deploy (responder < 500)
SMOKE_URLS="https://tu-dominio/up https://tu-dominio/api/heroes"
# Opcionales (valores por defecto en deploy-api.sh)
# DEPLOY_EXCLUDE="tests/ phpunit.xml .styleci.yml .editorconfig"
# DEPLOY_KEEP=".env .htaccess .user.ini error_log vendor/ vendor_broken/ storage/ node_modules/ bootstrap/cache/ public/storage .well-known/"
